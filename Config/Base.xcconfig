// Stickies — one place to configure the project.
//
// The project will NOT build until you change the identifiers below. The
// "com.example." placeholders are examples, not defaults — an identifier
// somebody else has already registered gives you "The app identifier … cannot
// be registered to your development team because it is not available", which
// means taken, not reserved.
//
// Prefer not to edit a tracked file? Create Config/Local.xcconfig with the same
// settings — it is git-ignored and, being included last, wins.

// 1. Your Apple Developer Team ID (Xcode ▸ Settings ▸ Accounts ▸ Manage Certificates,
//    or the "Team ID" on developer.apple.com ▸ Membership details).
DEVELOPMENT_TEAM =

// 2. A reverse-DNS bundle identifier nobody else has registered. It does not
//    have to be a domain you own; it does have to be unique across all Apple
//    developer accounts, so put your own name in it.
APP_BUNDLE_ID = com.example.stickies

// 3. The App Group the app and its widgets use to share the folder bookmark and
//    the widget snapshot. Must start with "group." — never with your team ID,
//    on either platform. See "Registering the App Group" in the README.
APP_GROUP_ID = group.com.example.stickies

// 4. The name shown under the icon. The Xcode target stays "Stickies"; this is
//    only what the user sees, so change it if you'd rather not share a name
//    with the Stickies app that ships with macOS.
APP_DISPLAY_NAME = Stickies

// ---------------------------------------------------------------------------
// Derived — you shouldn't need to touch anything below here.
// ---------------------------------------------------------------------------

WIDGET_BUNDLE_ID = $(APP_BUNDLE_ID).widgets

// Both platforms' entitlements use APP_GROUP_ID verbatim. Apple's portal only
// accepts group identifiers beginning with "group." — a team-prefixed literal
// in an entitlements file makes Xcode try to register a group by that name and
// fail. macOS still looks its container up under the team prefix at runtime, so
// the team ID is published to the app through Info.plist (see AppGroup.swift)
// and never appears in an entitlement.

MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1

IPHONEOS_DEPLOYMENT_TARGET = 17.0
MACOSX_DEPLOYMENT_TARGET = 14.0

SWIFT_VERSION = 5.0
SWIFT_STRICT_CONCURRENCY = minimal
SWIFT_EMIT_LOC_STRINGS = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES

SUPPORTED_PLATFORMS = iphoneos iphonesimulator macosx
SUPPORTS_MACCATALYST = NO
SUPPORTS_MAC_DESIGNED_FOR_IPHONE = NO
TARGETED_DEVICE_FAMILY = 1,2

CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY[sdk=macosx*] = -

// Optional untracked overrides. Included last so it beats everything above.
#include? "Local.xcconfig"
